# .env.example, modèle sans valeurs
#
# Copie ce fichier en .env à la racine du workspace et renseigne les clés. Le .env n'est jamais
# commité (voir .gitignore). Les scripts et les contrôles le lisent eux-mêmes ; quelques scripts
# veulent encore `set -a && . ./.env && set +a` depuis la racine, la skill boomball dit lesquels.

# --- Supabase, projet boomball ---
SUPABASE_BOOMBALL_REF=
SUPABASE_BOOMBALL_URL=
SUPABASE_BOOMBALL_ANON_KEY=
SUPABASE_BOOMBALL_SERVICE_ROLE_KEY=
SUPABASE_BOOMBALL_PWD=
# Jeton de l'API de gestion (migrations, déploiement des fonctions)
SUPABASE_API_KEY_BOOMBALL=

# --- Vercel ---
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# --- Comptes de test e2e ---
BOOMBALL_E2E_EMAIL=
BOOMBALL_E2E_PASSWORD=
BOOMBALL_E2E2_EMAIL=
BOOMBALL_E2E2_PASSWORD=
