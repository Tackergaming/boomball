{
  "name": "boomball",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Boomball, the traditional sport of the Giff. Co-op tactical match against AI.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p e2e",
    "sweep": "vitest run --config vitest.sweep.config.ts",
    "export:db": "node scripts/export-db.mjs",
    "build:function": "node scripts/build-edge-function.mjs",
    "deploy:function": "node scripts/deploy-edge-function.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts --grep-invert \"@playthrough|@board3d|@abandon|@coop|@account|@whole\"",
    "e2e:playthrough": "playwright test -c e2e/playwright.config.ts --grep @playthrough",
    "e2e:board3d": "playwright test -c e2e/playwright.config.ts --grep @board3d",
    "e2e:abandon": "playwright test -c e2e/playwright.config.ts --grep @abandon",
    "e2e:coop": "playwright test -c e2e/playwright.config.ts --grep @coop",
    "e2e:account": "playwright test -c e2e/playwright.config.ts --grep @account",
    "e2e:whole": "playwright test -c e2e/playwright.config.ts --grep @whole"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
